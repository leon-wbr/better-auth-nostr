{
  "name": "better-auth-nostr",
  "description": "Nostr plugin for Better Auth",
  "version": "0.8.0",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --project tsconfig.test.json",
    "test:watch": "vitest",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check . --fix --unsafe",
    "format": "biome format . --write",
    "knip": "knip",
    "check": "npm run lint && npm run typecheck && npm run coverage",
    "ci:local": "npm run check && npm run build",
    "mutate": "stryker run stryker.config.ts",
    "docs:generate": "npm run build && npm run generate -w scripts/docs",
    "docs:dev": "npm run dev -w scripts/docs",
    "docs:build": "npm run build -w scripts/docs",
    "prepublishOnly": "npm run build"
  },
  "workspaces": [
    "scripts/docs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "dev-source": "./src/client.ts",
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.mts"
      ]
    },
    "client": {
      "*": [
        "./dist/client.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "auth",
    "nostr",
    "typescript",
    "better-auth"
  ],
  "dependencies": {
    "nostr-tools": "^2.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/core": "^1.7.0",
    "@better-fetch/fetch": "^1.3.1",
    "@biomejs/biome": "2.5.0",
    "@nostr-dev-kit/ndk": "^3.0.3",
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/bun": "^1.3.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "applesauce-signers": "^7.1.0",
    "better-auth": "^1.7.0",
    "better-call": "^1.4.0",
    "knip": "^6.44.2",
    "pg": "^8.23.1",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^4.0.15"
  },
  "peerDependencies": {
    "@better-auth/core": "^1.7.0",
    "@better-fetch/fetch": "^1.3.1",
    "better-auth": "^1.7.0"
  },
  "homepage": "https://github.com/leon-wbr/better-auth-nostr#readme",
  "bugs": {
    "url": "https://github.com/leon-wbr/better-auth-nostr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leon-wbr/better-auth-nostr.git"
  },
  "author": "Leon Weber",
  "license": "MIT",
  "packageManager": "npm@11.6.2"
}
